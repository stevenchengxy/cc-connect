# DNS A record pointing to this Linux server.
PAIR_DOMAIN=pair.example.com
# Replace the documentation address with the server's real public IPv4.
TURN_PUBLIC_IP=203.0.113.10
# Primary IPv4 shown by "ip -4 -brief address". May be private on a cloud VM.
TURN_LOCAL_IP=203.0.113.10
# Choose your own login name. Add TURN_PASSWORD using the command in README.md.
TURN_USERNAME=my-device
