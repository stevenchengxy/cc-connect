{
  "name": "cc-connect",
  "version": "0.4.9",
  "description": "CC Connect remote desktop",
  "author": "CC Connect",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/build-native.cjs && electron .",
    "test": "node --test",
    "native": "node scripts/build-native.cjs",
    "dist:mac": "npm run native && electron-builder --mac dmg --universal -c.mac.identity=- --publish never",
    "dist:mac:signed": "node scripts/build-signed-mac.cjs",
    "dist:win": "npm run native && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node scripts/verify-desktop.cjs",
    "release:manifest": "node scripts/sign-release.cjs"
  },
  "dependencies": {
    "node-forge": "1.4.3",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.1"
  },
  "build": {
    "appId": "app.jianping.desktop",
    "productName": "CC Connect",
    "asar": true,
    "files": [
      "src/**",
      "native/*.cjs",
      "LICENSE"
    ],
    "artifactName": "CC-Connect-${version}-${arch}.${ext}",
    "directories": {
      "output": "release/${version}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "native/bin",
          "filter": [
            "**/*",
            "!**/*.exe"
          ]
        },
        {
          "from": "scripts/install-update-mac.sh",
          "to": "install-update-mac.sh"
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "CC Connect uses your local network to pair with a computer you invite.",
        "NSScreenCaptureUsageDescription": "CC Connect captures the display you choose and shares it with the device you authorize.",
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "zh-Hant"
        ]
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "native/bin",
          "filter": [
            "**/*.exe",
            "**/*.ps1",
            "**/*.cs"
          ]
        }
      ],
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "beforePack": "scripts/check-package.cjs",
    "afterPack": "scripts/localize-macos.cjs",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "uninstallDisplayName": "CC Connect",
      "createDesktopShortcut": "always",
      "shortcutName": "CC Connect",
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "zh_TW"
      ],
      "displayLanguageSelector": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenchengxy/cc-connect.git"
  },
  "homepage": "https://cc-connect-desktop.stevenchengxy19.chatgpt.site"
}
